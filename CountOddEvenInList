```public class Main {
    public static void main(String[] args) {
        int[] numbers = {12, 7, 9, 20, 33, 40};
        int evenCount = 0;
        int oddCount = 0;
        for (int num : numbers) {
            if (num % 2 == 0) {
                evenCount++;
            } else {
                oddCount++;
            }
        }
        System.out.println("Even: " + evenCount + ", Odd: " + oddCount);
    }
}

